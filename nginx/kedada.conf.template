# ======================================================================
# Kedada · frontend + proxy a la API
#
# Plantilla: la imagen oficial de nginx sustituye ${API_UPSTREAM} al
# arrancar (docker-compose.yml) y deja el resultado en conf.d/. Las
# variables propias de nginx ($host, $remote_addr…) no se tocan porque no
# existen como variables de entorno.
#
# Sirve public/ y reenvía /api/ a la API (Worker de Cloudflare o contenedor
# api-fiestas en la misma red Docker). El navegador ve un
# solo dominio: la cookie de sesión (SameSite=Lax) funciona y no hay CORS.
# ======================================================================

limit_req_zone  $binary_remote_addr zone=kedada_web:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=kedada_api:10m rate=8r/s;
limit_req_zone  $binary_remote_addr zone=kedada_img:10m rate=60r/s;
limit_conn_zone $binary_remote_addr zone=kedada_conn:10m;

# Caché de imágenes. Son inmutables (cambiar la foto crea otra URL), así que
# cada una llega al Worker UNA vez y el resto de visitas salen de aquí. Con
# 100 burbujas por pantalla, sin esto el mapa se comería la cuota gratuita
# de peticiones del Worker.
proxy_cache_path /var/cache/nginx/kedada_img levels=1:2 keys_zone=kedada_img:10m max_size=2g inactive=30d use_temp_path=off;

# User-agents que no queremos. Filtro, no defensa: se puede falsear.
map $http_user_agent $bloqueado {
    default                 0;
    ""                      1;
    "~*(nikto|sqlmap|nmap|masscan|nuclei|wpscan|dirbuster|gobuster)"  1;
    "~*(zgrab|censys|shodan|internetmeasurement)"                     1;
    "~*(semrush|ahrefs|mj12bot|dotbot|blexbot|petalbot|serpstat)"     1;
    "~*(gptbot|ccbot|claudebot|anthropic-ai|bytespider|amazonbot)"    1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    charset utf-8;

    # IP real detrás del reverse_proxy del homelab. El contenedor no publica
    # puertos, así que sólo le llega el proxy: se confía en rangos privados.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    limit_conn kedada_conn 30;
    limit_req_status 429;
    limit_conn_status 429;
    client_max_body_size 64k;   # el JSON más grande (un evento) no llega a 5 KB

    if ($bloqueado) { return 444; }

    include /etc/nginx/kedada/cabeceras.conf;

    # Sondeos típicos: cortar sin responder limpia los logs.
    location ~* ^/(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php) { return 444; }
    location ~* ^/(\.env|\.git|\.aws|\.ssh|config\.json|credentials) { return 444; }
    location ~* ^/(phpmyadmin|pma|adminer|cgi-bin|autoload) { return 444; }
    location ~* \.(php|asp|aspx|jsp|cgi|sh|sql|bak|old|swp)$ { return 444; }
    location ~ /\. { return 444; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # ------------------------------------------------------------------
    # API → Worker de Cloudflare o contenedor api-fiestas
    # Con variable + resolver, nginx vuelve a resolver el host cada 30 s
    # en lugar de quedarse para siempre con la IP del arranque (y arranca
    # aunque la API todavía no esté levantada).
    # 127.0.0.11 es el DNS de Docker: resuelve los nombres de los contenedores
    # de proxy_network y reenvía el resto (workers.dev) al DNS del host.
    # ------------------------------------------------------------------
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;
    set $api_esquema "${API_ESQUEMA}";
    set $api_upstream "${API_UPSTREAM}";

    location /api/ {
        limit_req zone=kedada_api burst=30 nodelay;
        include /etc/nginx/kedada/proxy-api.conf;
        proxy_read_timeout 20s;

        # Las respuestas dependen de la cookie: que nadie las cachee.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/kedada/cabeceras.conf;
    }

    # Imágenes: aquí se suben (POST) y se sirven (GET, cacheadas).
    location /api/imagenes/ {
        limit_req zone=kedada_img burst=200 nodelay;
        client_max_body_size 2m;   # grande (1,5 MB) + mini (100 KB) + multipart
        include /etc/nginx/kedada/proxy-api.conf;
        proxy_read_timeout 60s;    # subir desde un móvil con mala cobertura

        proxy_cache kedada_img;
        proxy_cache_methods GET HEAD;
        proxy_cache_key $uri;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        # La API manda Vary: Origin y cookies de sesión nada tienen que ver
        # con una imagen pública: una sola copia para todos.
        proxy_ignore_headers Vary Set-Cookie;
        add_header X-Cache $upstream_cache_status always;
        include /etc/nginx/kedada/cabeceras.conf;
    }

    # ------------------------------------------------------------------
    # Estáticos
    # ------------------------------------------------------------------

    # Fuentes y Leaflet no cambian entre despliegues: caché larga.
    location ~ ^/(fonts|vendor)/ {
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        include /etc/nginx/kedada/cabeceras.conf;
        access_log off;
    }

    location / {
        limit_req zone=kedada_web burst=60 nodelay;
        # Un estático sólo recibe GET/HEAD; lo demás es un sondeo.
        limit_except GET HEAD { deny all; }
        # Siempre revalida: un despliegue se ve al momento, sin versionar ficheros.
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/kedada/cabeceras.conf;
        try_files $uri $uri/ /index.html;
    }

    location = /robots.txt {
        default_type text/plain;
        access_log off;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = /healthz {
        default_type text/plain;
        access_log off;
        return 200 "ok\n";
    }

    location = /favicon.ico { access_log off; log_not_found off; return 204; }
}
