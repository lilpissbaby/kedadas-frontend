# ======================================================================
# Kedada · frontend + proxy a la API
#
# Plantilla: la imagen oficial de nginx sustituye ${API_UPSTREAM} al
# arrancar (docker-compose.yml) y deja el resultado en conf.d/. Las
# variables propias de nginx ($host, $remote_addr…) no se tocan porque no
# existen como variables de entorno.
#
# Sirve public/ y reenvía /api/ al Worker de Cloudflare. El navegador ve un
# solo dominio: la cookie de sesión (SameSite=Lax) funciona y no hay CORS.
# ======================================================================

limit_req_zone  $binary_remote_addr zone=kedada_web:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=kedada_api:10m rate=8r/s;
limit_conn_zone $binary_remote_addr zone=kedada_conn:10m;

# User-agents que no queremos. Filtro, no defensa: se puede falsear.
map $http_user_agent $bloqueado {
    default                 0;
    ""                      1;
    "~*(nikto|sqlmap|nmap|masscan|nuclei|wpscan|dirbuster|gobuster)"  1;
    "~*(zgrab|censys|shodan|internetmeasurement)"                     1;
    "~*(semrush|ahrefs|mj12bot|dotbot|blexbot|petalbot|serpstat)"     1;
    "~*(gptbot|ccbot|claudebot|anthropic-ai|bytespider|amazonbot)"    1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    charset utf-8;

    # IP real detrás del reverse_proxy del homelab. El contenedor no publica
    # puertos, así que sólo le llega el proxy: se confía en rangos privados.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    limit_conn kedada_conn 30;
    limit_req_status 429;
    limit_conn_status 429;
    client_max_body_size 64k;   # el JSON más grande (un evento) no llega a 5 KB

    if ($bloqueado) { return 444; }

    include /etc/nginx/kedada/cabeceras.conf;

    # Sondeos típicos: cortar sin responder limpia los logs.
    location ~* ^/(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php) { return 444; }
    location ~* ^/(\.env|\.git|\.aws|\.ssh|config\.json|credentials) { return 444; }
    location ~* ^/(phpmyadmin|pma|adminer|cgi-bin|autoload) { return 444; }
    location ~* \.(php|asp|aspx|jsp|cgi|sh|sql|bak|old|swp)$ { return 444; }
    location ~ /\. { return 444; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # ------------------------------------------------------------------
    # API → Cloudflare Worker
    # ------------------------------------------------------------------
    location /api/ {
        limit_req zone=kedada_api burst=30 nodelay;

        # Con variable + resolver, nginx vuelve a resolver el host cada 5 min
        # en lugar de quedarse para siempre con la IP del arranque.
        resolver 1.1.1.1 9.9.9.9 valid=300s ipv6=off;
        resolver_timeout 5s;
        set $api_upstream "${API_UPSTREAM}";

        proxy_pass https://$api_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_name $api_upstream;
        proxy_set_header Host $api_upstream;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;

        # Las respuestas dependen de la cookie: que nadie las cachee.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/kedada/cabeceras.conf;
    }

    # ------------------------------------------------------------------
    # Estáticos
    # ------------------------------------------------------------------

    # Fuentes y Leaflet no cambian entre despliegues: caché larga.
    location ~ ^/(fonts|vendor)/ {
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        include /etc/nginx/kedada/cabeceras.conf;
        access_log off;
    }

    location / {
        limit_req zone=kedada_web burst=60 nodelay;
        # Un estático sólo recibe GET/HEAD; lo demás es un sondeo.
        limit_except GET HEAD { deny all; }
        # Siempre revalida: un despliegue se ve al momento, sin versionar ficheros.
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/kedada/cabeceras.conf;
        try_files $uri $uri/ /index.html;
    }

    location = /robots.txt {
        default_type text/plain;
        access_log off;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = /healthz {
        default_type text/plain;
        access_log off;
        return 200 "ok\n";
    }

    location = /favicon.ico { access_log off; log_not_found off; return 204; }
}
